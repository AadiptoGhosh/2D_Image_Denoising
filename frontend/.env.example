# DSP Image Lab - Frontend Environment Configuration
# When deploying the backend separately (e.g. on Render, Railway, Fly.io, or VPS),
# specify the full public URL of the FastAPI backend service:
# Example: VITE_API_BASE_URL=https://dsp-image-lab-api.onrender.com
#
# When using same-origin hosting or local development Vite proxy (http://127.0.0.1:8000),
# leave this empty:
VITE_API_BASE_URL=
